{
  "name": "@valotas/web",
  "version": "3.16.4",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/valotas/valotas.com.git"
  },
  "private": true,
  "devDependencies": {
    "@parcel/optimizer-cssnano": "^2.16.4",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.28",
    "postcss-url": "^10.1.4",
    "rimraf": "^6.1.3",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "clean": "rimraf dist node_modules",
    "lint": "eslint \"src/**/*.+(ts|js|tsx|jsx)\"",
    "fix": "npm run lint -- --fix",
    "build": "parcel build src/robots.txt --no-autoinstall",
    "deploy": "npm run build",
    "watch:build": "parcel watch src/robots.txt --no-autoinstall --no-cache",
    "serve": "serve dist",
    "preversion": "npm run lint",
    "version": "npm run deploy"
  },
  "dependencies": {
    "parcel": "^2.16.4",
    "reveal.js": "^6.0.2"
  }
