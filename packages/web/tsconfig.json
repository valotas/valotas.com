{
  "compilerOptions": {
    "rootDir": "src/",
    "outDir": "dist/",
    "target": "ES2020",
    "lib": ["dom", "ES2020"],
    "module": "ES2020",
    "moduleResolution": "bundler",
    "sourceMap": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "removeComments": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "importHelpers": true
  },
  "exclude": [
    "node_modules"
  ]
}
