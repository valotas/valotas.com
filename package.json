{
    "name": "@valotas/valotas.com",
    "workspaces": [
        "packages/frontend",
        "packages/parcel-resolver-staticsite",
        "packages/parcel-namer-staticsite",
        "packages/parcel-transformer-staticsite",
        "packages/html2pdf",
        "packages/web"
    ],
    "scripts": {
        "clean": "npm run clean --workspaces --if-present && rimraf .parcel-cache",
        "lint": "npm run lint --workspaces --if-present",
        "fix": "npm run fix --workspaces --if-present",
        "watch:frontend": "npm run watch:build -w packages/frontend",
        "watch:web": "npm run watch:build -w packages/web",
        "build": "npm run build --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "sb": "npm run storybook -w packages/frontend",
        "serve": "npm run serve -w packages/web",
        "dev": "run-p watch:* serve",
        "bump": "npm version --include-workspace-root --workspaces --no-git-tag-version",
        "postbump": "node packages/scripts/postbump.mjs",
        "release-patch": "npm run bump patch"
    },
    "version": "3.16.4",
    "alias": {
        "markdown-to-jsx/entities": "./node_modules/markdown-to-jsx/dist/entities.browser.js",
        "reveal.js/plugin/notes": "./node_modules/reveal.js/dist/plugin/notes.mjs",
        "reveal.js/plugin/highlight": "./node_modules/reveal.js/dist/plugin/highlight.mjs"
    },
    "devDependencies": {
        "@swc/jest": "^0.2.39",
        "@types/jest": "^30.0.0",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@typescript-eslint/parser": "^8.70.1",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.12.0",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "jest-fetch-mock": "^4.2.0",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.9.8",
        "sharp": "^0.33.5",
        "typescript": "6.0"
    },
    "dependencies": {
        "tslib": "^2.8.1"
    }
}
